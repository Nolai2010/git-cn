<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>GitCn.Cli</RootNamespace>
    <AssemblyName>git-cn</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>2.55.0-cn1</Version>
    <Description>中文优先的 Git 命令行工具箱</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GitCn.Core\GitCn.Core.csproj" />
  </ItemGroup>

</Project>
