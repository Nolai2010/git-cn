<Window x:Class="GitCn.App.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="危险操作确认" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="18,16">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="Bold"
                   Foreground="{StaticResource Danger}" Text="危险操作"/>
        <TextBlock Style="{StaticResource SectionTitle}" Text="会造成什么后果"/>
        <TextBlock x:Name="HarmText" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <TextBlock Style="{StaticResource SectionTitle}" Text="更安全的做法"/>
        <TextBlock x:Name="SaferText" TextWrapping="Wrap" Margin="0,0,0,10"/>
        <CheckBox x:Name="BackupCheck" Margin="0,0,0,14" IsChecked="True"
                  Content="先帮我备份一份：git stash push -u（会连未跟踪文件一起收进 stash，之后 git stash pop 取回）"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelBtn" Content="取消" IsCancel="True" MinWidth="86"
                    Click="CancelBtn_Click"/>
            <Button x:Name="OkBtn" Content="我懂后果，仍要执行" IsDefault="True" MinWidth="150"
                    Foreground="{StaticResource Danger}" FontWeight="SemiBold" Click="OkBtn_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
