#!/bin/sh
# Git Bash / WSL 入口：shim 只负责找到一个真能跑的 python，逻辑都在 git_cn.py
D=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for py in python3 python py; do
    command -v "$py" >/dev/null 2>&1 || continue
    # Windows 上的 python3 常常只是 Microsoft Store 的空壳别名，能执行才算数
    "$py" -c 'import sys' >/dev/null 2>&1 || continue
    exec "$py" "$D/git_cn.py" "$@"
done
echo "[git-cn] 需要 Python 3，请先安装：winget install Python.Python.3" >&2
exit 127
